              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "info": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": ["country", "territory", "water", "region"]
                  },
                  "region": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "geometry": {
                    "type": "object",
                    "required": ["type", "coordinates"],
                    "properties": {
                      "type": {
                        "enum": ["Point", "Polygon", "MultiPolygon"]
                      },
                      "coordinates": {
                        "type": "array",
                        "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
                      }
                    }
                  },
                  "center": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "approximate": {
                    "type": "boolean"
                  },
                  "small": {
                    "type": "boolean"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
