            }
          }
        }
      }
    },
    "/api/backup": {
      "get": {
        "operationId": "exportBackup",
        "summary": "Complete versioned collection, settings, cards, and review history",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation failed; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/restore": {
      "post": {
        "operationId": "restoreBackup",
        "summary": "Atomically restore an export after making a local snapshot",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation failed; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "format": {
                    "const": "migs-geo"
                  },
                  "version": {
                    "const": 1
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "newPerDay": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 500
                      },
                      "retention": {
                        "type": "number",
                        "minimum": 0.7,
                        "maximum": 0.97
                      },
                      "kinds": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": [
                            "country",
                            "territory",
                            "water",
                            "region"
                          ]
                        }
                      },
                      "regions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "modes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": [
                            "locate",
                            "identify"
                          ]
                        }
                      },
                      "burySiblings": {
                        "type": "boolean"
                      }
                    }
                  },
                  "places": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "geometry"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "info": {
                          "type": "string"
                        },
                        "kind": {
                          "enum": [
                            "country",
                            "territory",
                            "water",
                            "region"
                          ]
                        },
                        "region": {
                          "type": "string"
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "geometry": {
                          "type": "object",
                          "required": [
                            "type",
                            "coordinates"
                          ],
                          "properties": {
                            "type": {
                              "enum": [
                                "Point",
                                "Polygon",
                                "MultiPolygon"
                              ]
                            },
                            "coordinates": {
                              "type": "array",
                              "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
                            }
                          }
                        },
                        "center": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "approximate": {
                          "type": "boolean"
                        },
                        "small": {
                          "type": "boolean"
                        },
                        "archived": {
                          "type": "boolean"
                        },
                        "source": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "cards": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "reviews": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                },
                "required": [
                  "format",
                  "version",
                  "settings",
                  "places",
                  "cards",
                  "reviews"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Place": {
        "type": "object",
        "required": [
          "name",
          "geometry"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "info": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "country",
              "territory",
              "water",
              "region"
            ]
          },
          "region": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Point",
                  "Polygon",
                  "MultiPolygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
              }
            }
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "approximate": {
            "type": "boolean"
          },
          "small": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "newPerDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "retention": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 0.97
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "country",
                "territory",
                "water",
                "region"
              ]
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "locate",
                "identify"
              ]
            }
          },
          "burySiblings": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
