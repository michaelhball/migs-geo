    "/api/backup": {
      "get": {
        "operationId": "exportBackup",
        "summary": "Version 2 export of collection, settings, cards, reviews, and complete study log",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation failed; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/restore": {
      "post": {
        "operationId": "restoreBackup",
        "summary": "Atomically restore an export after making a local snapshot",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation failed; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "format": {
                    "const": "migs-geo"
                  },
                  "version": {
                    "enum": [1, 2]
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "newPerDay": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 500
                      },
                      "retention": {
                        "type": "number",
                        "minimum": 0.7,
                        "maximum": 0.97
                      },
                      "kinds": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": ["country", "territory", "water", "region"]
                        }
                      },
                      "regions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "modes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": ["locate", "identify"]
                        }
                      },
                      "burySiblings": {
                        "type": "boolean"
                      }
                    }
                  },
                  "places": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "geometry"],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "info": {
                          "type": "string"
                        },
                        "kind": {
                          "enum": ["country", "territory", "water", "region"]
                        },
                        "region": {
                          "type": "string"
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "geometry": {
                          "type": "object",
                          "required": ["type", "coordinates"],
                          "properties": {
                            "type": {
                              "enum": ["Point", "Polygon", "MultiPolygon"]
                            },
                            "coordinates": {
                              "type": "array",
                              "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
                            }
                          }
                        },
                        "center": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "approximate": {
                          "type": "boolean"
                        },
                        "small": {
                          "type": "boolean"
                        },
                        "archived": {
                          "type": "boolean"
                        },
                        "source": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "cards": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "reviews": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "studyLog": {
                    "type": "object",
                    "properties": {
                      "attempts": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": ["attempts", "checks"]
                  }
                },
                "required": [
                  "format",
                  "version",
                  "settings",
                  "places",
                  "cards",
                  "reviews"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "version": {
                          "const": 2
                        }
                      }
                    },
                    "then": {
                      "required": ["studyLog"]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/study/log": {
      "get": {
        "operationId": "getStudyLog",
        "summary": "Read persistent attempts and ordered answer checks",
        "parameters": [
          {
            "in": "query",
            "name": "cardId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "includePractice",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated log; items include snapshot, ordered checks, review_id, rating and undone status. Checks include raw answer, result, sequence and response_ms.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Place": {
        "type": "object",
        "required": ["name", "geometry"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "info": {
            "type": "string"
          },
          "kind": {
            "enum": ["country", "territory", "water", "region"]
          },
          "region": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "enum": ["Point", "Polygon", "MultiPolygon"]
              },
              "coordinates": {
                "type": "array",
                "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
              }
            }
          },
          "center": {
