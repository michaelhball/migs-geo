            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "answer": {
                    "type": "object",
                    "properties": {
                      "point": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "text": {
                        "type": "string"
                      },
                      "reveal": {
                        "type": "boolean"
                      }
                    },
                    "required": []
                  }
                },
                "required": ["token", "answer"]
              }
            }
          }
        }
      }
    },
    "/api/study/rate": {
      "post": {
        "operationId": "rateAnswer",
        "summary": "Commit a review atomically; duplicate tokens are idempotent",
