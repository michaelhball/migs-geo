          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "operationId": "updatePlace",
        "summary": "Edit a place without resetting its schedule",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation failed; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "info": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "country",
                      "territory",
                      "water",
                      "region"
                    ]
                  },
                  "region": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "geometry": {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "Point",
                          "Polygon",
                          "MultiPolygon"
                        ]
                      },
                      "coordinates": {
                        "type": "array",
                        "description": "GeoJSON [longitude, latitude] coordinates; polygon rings are closed."
                      }
                    }
                  },
                  "center": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "approximate": {
                    "type": "boolean"
                  },
                  "small": {
                    "type": "boolean"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "archivePlace",
        "summary": "Archive a place, preserving all data",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
