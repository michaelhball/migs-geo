                  "token": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "description": "1 Again, 2 Hard, 3 Good, 4 Easy"
                  }
                },
                "required": ["token", "rating"]
              }
            }
          }
        }
      }
    },
